---
import BaseLayout from '../layouts/BaseLayout.astro';
import { foodRepository } from '../lib/server/foodRepository.mjs';
import { getAllReadingFromDb } from '../lib/server/readingArchiveView.mjs';
import { postRepository } from '../lib/server/postRepository.mjs';
import { siteConfigRepository } from '../lib/server/siteConfigRepository.mjs';
import { getWatchArchiveFromDb } from '../lib/server/watchArchiveView.mjs';

const siteConfig = siteConfigRepository.getSiteConfig();
const sections = Object.fromEntries(siteConfigRepository.listSections().map((section) => [section.key, section]));
const topicCount = siteConfig.topics?.cards?.length ?? 0;
postRepository.ensureSeededFromContent();
const publishedPostCount = postRepository.stats().published;
const watchTotal = getWatchArchiveFromDb().stats.total;
const readingTotal = getAllReadingFromDb().length;
const foodTotal = foodRepository.list({ limit: 500, publishedOnly: true }).items.length;
const navSmall = (key, fallback) => {
  const value = sections[key]?.navSmall || fallback;
  return value === 'auto' ? fallback : value;
};
const aboutParagraphs = String(siteConfig.aboutBody || '').split(/\n{2,}/).filter(Boolean);
---

<BaseLayout
  title={`关于 | ${siteConfig.brandName}`}
  description={`关于${siteConfig.brandName}和站点作者。`}
  chrome={false}
  shell={false}
>
  <div class="qzq-home qzq-about-page">
    <nav class="qzq-nav" aria-label="Primary navigation">
      <a class="qzq-brand" href="/">{siteConfig.brandName}</a>
      <div class="qzq-nav-links">
        <a class="qzq-nav-item" href="/#topics"><span>{sections.topics?.navLabel || '主线'}</span><small>{topicCount}</small></a>
        <a class="qzq-nav-item" href="/writing"><span>{sections.notes?.navLabel || '笔记'}</span><small>{navSmall('notes', String(publishedPostCount))}</small></a>
        <a class="qzq-nav-item" href="/#watch"><span>{sections.watch?.navLabel || '影像'}</span><small>{navSmall('watch', String(watchTotal))}</small></a>
        <a class="qzq-nav-item" href="/#food"><span>{sections.food?.navLabel || '美食'}</span><small>{navSmall('food', String(foodTotal))}</small></a>
        <a class="qzq-nav-item" href="/#reading"><span>{sections.reading?.navLabel || '书架'}</span><small>{navSmall('reading', String(readingTotal))}</small></a>
        <a class="qzq-nav-item" href="/#statistics"><span>{sections.statistics?.navLabel || '统计'}</span><small>{navSmall('statistics', '∞')}</small></a>
      </div>
      <div class="qzq-socials" aria-label="站点工具">
        <button type="button" class="global-search-trigger" data-global-search-open aria-label="打开全站搜索">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m16 16 5 5"></path>
          </svg>
        </button>
        <a class="qzq-about-link" href="/about" aria-label="关于" title="关于" aria-current="page">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="8" r="4"></circle>
            <path d="M4.5 21a7.5 7.5 0 0 1 15 0"></path>
          </svg>
        </a>
      </div>
    </nav>

    <section class="qzq-about-hero" aria-label="关于">
      <div class="qzq-about-kicker">About / {siteConfig.brandName}</div>
      <h1>{siteConfig.aboutTitle}</h1>
      {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section class="qzq-about-grid" aria-label="个人信息">
      <article>
        <span>Now</span>
        <h2>正在关注</h2>
        <p>{siteConfig.aboutNow}</p>
      </article>
      <article>
        <span>Method</span>
        <h2>记录方式</h2>
        <p>{siteConfig.aboutMethod}</p>
      </article>
      <article>
        <span>Taste</span>
        <h2>审美偏好</h2>
        <p>{siteConfig.aboutTaste}</p>
      </article>
      <article>
        <span>Contact</span>
        <h2>联系我</h2>
        <p class="qzq-about-contact">
          <a href={siteConfig.social.github} target="_blank" rel="noreferrer">GitHub</a>
          <a href={siteConfig.social.bilibili} target="_blank" rel="noreferrer">B站</a>
          <button type="button" data-about-qq data-qq-parts={String(siteConfig.social.qq || '').match(/.{1,3}/g)?.join(',') || ''}>显示QQ</button>
        </p>
      </article>
    </section>
  </div>
  <script>
    const qqButton = document.querySelector<HTMLButtonElement>('[data-about-qq]');
    qqButton?.addEventListener('click', () => {
      const number = (qqButton.dataset.qqParts || '').split(',').join('');
      qqButton.textContent = qqButton.textContent === '显示QQ' && number ? number : '显示QQ';
    });
  </script>
</BaseLayout>
