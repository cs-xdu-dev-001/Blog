---
import BaseLayout from '../layouts/BaseLayout.astro';
import { postRepository } from '../lib/server/postRepository.mjs';

postRepository.ensureSeededFromContent();
const posts = postRepository.list({ filter: 'published', limit: 500 }).items;
const isAlgorithmPost = (post) => [...(post.tags || []), ...(post.topicSlugs || [])]
  .some((value) => /^(leetcode|算法|algorithm)$/i.test(String(value).trim()));
const writingFilters = [
  { key: 'technical', label: '技术' },
  { key: 'algorithm', label: '算法' },
  { key: 'reflection', label: '随记' },
  { key: 'all', label: '全部' },
];
const requestedFilter = Astro.url.searchParams.get('type') || 'technical';
const initialFilter = writingFilters.some((item) => item.key === requestedFilter)
  ? requestedFilter
  : 'all';
const initialCount = posts.filter((post) => (
  initialFilter === 'all'
  || (initialFilter === 'algorithm' && isAlgorithmPost(post))
  || (initialFilter === 'technical' && post.kind === 'technical' && !isAlgorithmPost(post))
  || (initialFilter === 'reflection' && post.kind === 'reflection')
)).length;

const formatDate = (date) =>
  new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
---

<BaseLayout title="近期笔记 | Dev Notes" description="全部笔记索引。">
  <header class="writing-hero">
    <div class="writing-heading">
      <h1>近期笔记</h1>
      <span>{posts.length}篇笔记</span>
    </div>
    <p>写下做过的东西，免得下次再从头找。</p>
  </header>

  <div class="writing-index-head">
    <nav class="writing-filter" aria-label="笔记类型">
      <button
        type="button"
        class:list={['writing-filter-button', { 'is-active': initialFilter === 'technical' }]}
        data-writing-filter="technical"
        aria-pressed={initialFilter === 'technical' ? 'true' : 'false'}
      >技术笔记</button>
      <button
        type="button"
        class:list={['writing-filter-button', { 'is-active': initialFilter === 'algorithm' }]}
        data-writing-filter="algorithm"
        aria-pressed={initialFilter === 'algorithm' ? 'true' : 'false'}
      >算法</button>
      <button
        type="button"
        class:list={['writing-filter-button', { 'is-active': initialFilter === 'reflection' }]}
        data-writing-filter="reflection"
        aria-pressed={initialFilter === 'reflection' ? 'true' : 'false'}
      >随记</button>
      <button
        type="button"
        class:list={['writing-filter-button', { 'is-active': initialFilter === 'all' }]}
        data-writing-filter="all"
        aria-pressed={initialFilter === 'all' ? 'true' : 'false'}
      >全部</button>
    </nav>
    <span data-writing-count>{String(initialCount).padStart(2, '0')}</span>
  </div>

  <section class="writing-list" aria-label="全部笔记">
    {posts.map((post, index) => {
      const kind = post.kind;
      const algorithm = isAlgorithmPost(post);
      const isHidden = !(
        initialFilter === 'all'
        || (initialFilter === 'algorithm' && algorithm)
        || (initialFilter === 'technical' && kind === 'technical' && !algorithm)
        || (initialFilter === 'reflection' && kind === 'reflection')
      );
      return (
        <a
          class="writing-row"
          href={`/posts/${post.slug}`}
          style={`--row-index: ${index};`}
          data-writing-kind={kind}
          data-writing-algorithm={algorithm ? 'true' : 'false'}
          hidden={isHidden}
        >
          <span class="writing-row-number" data-writing-number>{String(index + 1).padStart(2, '0')}</span>
          <span class="writing-row-main">
            <strong>{post.data.title}</strong>
            {post.locked ? <span class="post-lock-inline">加密</span> : post.data.description && <span>{post.data.description}</span>}
          </span>
          <span class="writing-row-meta">
            <b>{formatDate(post.data.date)}</b>
            <i>{post.kindLabel}</i>
          </span>
          <span class="writing-row-arrow" aria-hidden="true">↗</span>
        </a>
      );
    })}
    {initialCount === 0 && (
      <p class="writing-empty" data-writing-empty>
        {initialFilter === 'reflection' ? '还没有随记。' : initialFilter === 'algorithm' ? '还没有算法笔记。' : '还没有这一类笔记。'}
      </p>
    )}
  </section>

  <script>
    const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-writing-filter]')];
    const writingRows = [...document.querySelectorAll<HTMLElement>('[data-writing-kind]')];
    const countElement = document.querySelector<HTMLElement>('[data-writing-count]');
    let emptyElement = document.querySelector<HTMLElement>('[data-writing-empty]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const validFilters = new Set(['all', 'technical', 'algorithm', 'reflection']);

    function filterFromUrl() {
      const value = new URL(window.location.href).searchParams.get('type') || 'technical';
      return validFilters.has(value) ? value : 'technical';
    }

    function syncEmptyState(visibleCount, selected) {
      if (visibleCount > 0) {
        emptyElement?.remove();
        emptyElement = null;
        return;
      }
      if (!emptyElement) {
        emptyElement = document.createElement('p');
        emptyElement.className = 'writing-empty';
        emptyElement.dataset.writingEmpty = '';
        document.querySelector('.writing-list')?.append(emptyElement);
      }
      emptyElement.textContent = selected === 'reflection'
        ? '还没有随记。'
        : selected === 'algorithm' ? '还没有算法笔记。' : '还没有这一类笔记。';
    }

    function applyWritingFilter(filter, { updateUrl = true, animate = true } = {}) {
      const selected = validFilters.has(filter) ? filter : 'technical';
      let visibleIndex = 0;

      filterButtons.forEach((button) => {
        const active = button.dataset.writingFilter === selected;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      writingRows.forEach((row) => {
        const algorithm = row.dataset.writingAlgorithm === 'true';
        const visible = selected === 'all'
          || (selected === 'algorithm' && algorithm)
          || (selected === 'technical' && row.dataset.writingKind === 'technical' && !algorithm)
          || (selected === 'reflection' && row.dataset.writingKind === 'reflection');
        row.hidden = !visible;
        if (!visible) return;
        visibleIndex += 1;
        const number = row.querySelector<HTMLElement>('[data-writing-number]');
        if (number) number.textContent = String(visibleIndex).padStart(2, '0');
        if (animate && !reducedMotion.matches) {
          row.animate(
            [
              { opacity: 0.25, transform: 'translateY(7px)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            {
              duration: 220,
              delay: Math.min(visibleIndex - 1, 7) * 18,
              easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
              fill: 'both',
            },
          );
        }
      });

      if (countElement) countElement.textContent = String(visibleIndex).padStart(2, '0');
      syncEmptyState(visibleIndex, selected);

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (selected === 'technical') url.searchParams.delete('type');
        else url.searchParams.set('type', selected);
        history.replaceState({ writingFilter: selected }, '', url);
      }
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => applyWritingFilter(button.dataset.writingFilter || 'all'));
    });
    window.addEventListener('popstate', () => applyWritingFilter(filterFromUrl(), { updateUrl: false }));
    applyWritingFilter(filterFromUrl(), { updateUrl: false, animate: false });
  </script>
</BaseLayout>
