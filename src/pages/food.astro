---
import BaseLayout from '../layouts/BaseLayout.astro';
import { foodRepository } from '../lib/server/foodRepository.mjs';

const { items, stats } = foodRepository.list({ limit: 500, publishedOnly: true });
---

<BaseLayout title="美食 | Dev Notes" description="吃过、常去和准备去试的店。">
  <div class="food-archive-shell">
    <header class="food-archive-head">
      <a href="/">返回首页</a>
      <h1>美食</h1>
      <span>{stats.published}条记录</span>
    </header>

    <nav class="food-filter-bar" aria-label="美食筛选">
      <button class="is-active" type="button" data-food-archive-filter="all">全部</button>
      <button type="button" data-food-archive-filter="吃过">吃过</button>
      <button type="button" data-food-archive-filter="常去">常去</button>
      <button type="button" data-food-archive-filter="想去">想去</button>
    </nav>

    <section class="food-archive-grid" aria-label="全部美食记录">
      {items.map((item) => (
        <a class="food-archive-card" href={`/food/${item.id}`} data-food-archive-card data-food-status={item.status}>
          <figure class={item.image_path ? 'has-image' : ''}>
            {item.image_path ? (
              <img
                src={item.image_small_path || item.image_path}
                srcset={item.image_small_path ? `${item.image_small_path} 480w, ${item.image_path} 960w` : undefined}
                sizes="(max-width: 760px) 92vw, 360px"
                width={item.image_width || 960}
                height={item.image_height || 720}
                alt={`${item.title}${item.dish ? `的${item.dish}` : ''}`}
                loading="lazy"
                decoding="async"
              />
            ) : <span aria-hidden="true">食</span>}
          </figure>
          <div>
            <span>{item.status}{item.area ? ` · ${item.area}` : ''}</span>
            <h2>{item.title}</h2>
            <p>{item.dish || '未填写代表菜'}</p>
            {item.rating && <strong>{item.rating}</strong>}
          </div>
        </a>
      ))}
      {!items.length && <p class="food-archive-empty">还没有公开的美食记录。</p>}
    </section>
  </div>

  <script>
    const filters = document.querySelectorAll('[data-food-archive-filter]');
    const cards = document.querySelectorAll('[data-food-archive-card]');
    filters.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-food-archive-filter') || 'all';
        filters.forEach((item) => item.classList.toggle('is-active', item === button));
        cards.forEach((card) => {
          card.hidden = filter !== 'all' && card.getAttribute('data-food-status') !== filter;
        });
      });
    });
  </script>
</BaseLayout>
