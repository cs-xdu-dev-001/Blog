---
const { config = {} } = Astro.props;
const repo = String(config.repo || '').trim();
const repoId = String(config.repoId || '').trim();
const category = String(config.category || '').trim();
const categoryId = String(config.categoryId || '').trim();
const ready = Boolean(repo && repoId && category && categoryId);
---

{ready && (
  <div class="qzq-comments-embed">
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="light"
      data-lang="zh-CN"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
  </div>
)}
